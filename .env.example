# Platum Supabase tooling values. Copy this file to .env and populate it only
# from the Supabase project assigned to Platum.
SUPABASE_PROJECT_REF=your_platum_project_ref
SUPABASE_URL=https://your-platum-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_platum_key

# Never put a service-role or secret key in browser code. The optional Telegram
# worker has a separate server-only template at bot/.env.example.
# Platum server-only workspace management (Vercel Functions).
# Use only this project's verified Supabase target. Do not put the service key in browser config.
PLATUM_SUPABASE_URL=
PLATUM_SUPABASE_SERVICE_ROLE_KEY=
PLATUM_APP_URL=https://client-cabinet.vercel.app
# Comma-separated confirmed Auth user UUIDs allowed to create the first workspace.
# Existing workspace owners/administrators can create further workspaces.
PLATUM_BOOTSTRAP_USER_IDS=
# Local dev server only: browser-safe key for the isolated local Supabase instance.
PLATUM_SUPABASE_PUBLISHABLE_KEY=
